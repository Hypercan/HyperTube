# Supabase → Project Settings → API Keys (use the secret key, never expose it to the browser)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=

# Google Cloud Console → APIs & Services → YouTube Data API v3 → Credentials → API key
YOUTUBE_API_KEY=

# Google AI Studio → Get API key (free tier is enough, see docs/adr/0003)
GEMINI_API_KEY=
GEMINI_SCREENING_MODEL=gemini-flash-lite-latest
GEMINI_SYLLABUS_MODEL=gemini-flash-latest

# Password for the single user (ADR-0002); changing it logs every browser out
APP_PASSWORD=

# Any long random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=

# Max minutes of video sent to Gemini for Derin analiz per day (free tier allows 8h)
DAILY_DEEP_ANALYSIS_MINUTES=360
